<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Elysian Hope Foundation — Bringing Hope One Heart At A Time</title>
<meta name="description" content="Elysian Hope Foundation is a registered Kenyan NGO (NGO-KJUDKPB) supporting youth, street children, orphans, and vulnerable children through advocacy, food aid, direct services, and training across Nairobi, Nakuru, Kiambu, Kajiado, and Vihiga counties.">
<meta property="og:title" content="Elysian Hope Foundation">
<meta property="og:description" content="Bringing hope, one heart at a time — supporting vulnerable children and families across Kenya through advocacy, aid, services, and training.">
<meta property="og:type" content="website">
<meta name="description" content="Elysian Hope Foundation is a registered Kenyan NGO (NGO-KJUDKPB) supporting vulnerable youth, street children, and orphans across Nairobi, Nakuru, Kiambu, Kajiado, and Vihiga through advocacy, food aid, direct services, and training.">
<meta property="og:title" content="Elysian Hope Foundation">
<meta property="og:description" content="Bringing hope, one heart at a time — a registered Kenyan NGO supporting vulnerable children and families.">
<meta property="og:type" content="website">
<link rel="icon" href="data:image/png;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg: #FFFEFB;
    --ink: #201C1E;
    --ink-soft: #5C5559;
    --purple: #7A1FAE;
    --purple-deep: #4E1470;
    --lavender: #F5E9FA;
    --orange: #E67E00;
    --orange-soft: #FCE3BE;
    --pink: #E5007D;
    --pink-deep: #B8005F;
    --green: #37B233;
    --line: #ECE3E9;
    --max: 1120px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--bg);
    color:var(--ink);
    font-family:'Work Sans', sans-serif;
    font-size:17px;
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3{
    font-family:'Fraunces', serif;
    font-weight:600;
    margin:0;
    color:var(--ink);
    line-height:1.08;
  }
  p{margin:0;}
  a{color:inherit;}
  .wrap{max-width:var(--max); margin:0 auto; padding:0 32px;}
  img, svg{display:block; max-width:100%;}

  /* focus visibility */
  a:focus-visible, button:focus-visible{
    outline:2px solid var(--orange);
    outline-offset:3px;
  }

  @media (prefers-reduced-motion: reduce){
    *{animation:none !important; transition:none !important;}
  }

  /* ---------- Header ---------- */
  header{
    position:sticky; top:0; z-index:20;
    background:rgba(251,247,239,0.92);
    backdrop-filter:blur(6px);
    border-bottom:1px solid var(--line);
  }
  .nav{
    display:flex; align-items:center; justify-content:space-between;
    padding:20px 32px;
    max-width:var(--max); margin:0 auto;
  }
  .wordmark{
    display:flex;
    align-items:center;
    gap:10px;
    font-family:'Fraunces', serif;
    font-size:1.25rem;
    font-weight:600;
    letter-spacing:0.01em;
    text-decoration:none;
    color:var(--ink);
  }
  .wordmark span{color:var(--green);}
  .wordmark-icon{
    width:44px; height:44px;
    border-radius:50%;
    object-fit:cover;
    flex-shrink:0;
  }
  .navlinks{
    display:flex; gap:32px; list-style:none; margin:0; padding:0;
  }
  .navlinks a{
    text-decoration:none;
    font-size:0.95rem;
    color:var(--ink-soft);
    transition:color .15s ease;
  }
  .navlinks a:hover{color:var(--purple-deep);}
  .navcta{
    background:var(--pink);
    color:#fff !important;
    padding:10px 20px;
    border-radius:3px;
    font-size:0.9rem;
    text-decoration:none;
    white-space:nowrap;
  }
  .navcta:hover{background:var(--pink-deep);}
  .menubtn{display:none; background:none; border:none; cursor:pointer; padding:4px;}
  .menubtn svg{width:26px; height:26px;}

  @media (max-width:820px){
    .navlinks{
      position:fixed; top:73px; left:0; right:0;
      flex-direction:column; gap:0;
      background:var(--bg);
      border-bottom:1px solid var(--line);
      max-height:0; overflow:hidden;
      transition:max-height .25s ease;
    }
    .navlinks.open{max-height:320px;}
    .navlinks a{padding:16px 32px; border-top:1px solid var(--line); width:100%; display:block;}
    .navlinks .navcta{margin:16px 32px; text-align:center; width:calc(100% - 64px); border-radius:3px;}
    .menubtn{display:block;}
  }

  /* ---------- Hero ---------- */
  .hero{
    padding:88px 0 96px;
    overflow:hidden;
  }
  .hero .wrap{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:40px;
    align-items:center;
  }
  .eyebrow{
    color:var(--orange);
    font-size:0.95rem;
    font-style:italic;
    font-family:'Fraunces', serif;
    margin-bottom:18px;
  }
  .hero h1{
    font-size:clamp(2.4rem, 4.6vw, 3.6rem);
    max-width:12ch;
  }
  .hero p.lede{
    margin-top:24px;
    max-width:46ch;
    color:var(--ink-soft);
    font-size:1.08rem;
  }
  .hero-ctas{
    margin-top:34px;
    display:flex; gap:16px; flex-wrap:wrap;
  }
  .btn{
    display:inline-block;
    padding:14px 26px;
    border-radius:3px;
    text-decoration:none;
    font-size:0.98rem;
    font-weight:500;
    border:1px solid transparent;
    transition:transform .15s ease, background .15s ease;
  }
  .btn-primary{background:var(--pink); color:#fff;}
  .btn-primary:hover{background:var(--pink-deep);}
  .btn-outline{border-color:var(--ink); color:var(--ink);}
  .btn-outline:hover{background:var(--ink); color:var(--bg);}

  .hero-art{
    position:relative;
    aspect-ratio:1/1;
    padding:24px;
  }
  .hero-art::before{
    content:"";
    position:absolute; inset:0;
    background:radial-gradient(circle, rgba(229,0,125,0.14) 0%, rgba(122,31,174,0.12) 45%, rgba(255,255,255,0) 72%);
    border-radius:50%;
  }
  .hero-art svg{width:100%; height:100%; position:relative;}
  .hero-art img{width:100%; height:100%; object-fit:contain; position:relative;}

  .place{
    margin-top:28px;
    font-size:0.88rem;
    color:var(--ink-soft);
    display:flex; align-items:center; gap:8px;
  }
  .place svg{width:16px; height:16px; flex-shrink:0;}

  @media (max-width:820px){
    .hero .wrap{grid-template-columns:1fr; text-align:left;}
    .hero-art{max-width:280px; margin-top:8px;}
  }

  /* ---------- Band sections ---------- */
  section{padding:88px 0;}
  .band-green{
    background:var(--purple-deep);
    color:#F3EEF6;
  }
  .band-green h2, .band-green h3{color:#fff;}
  .band-mint{background:var(--lavender);}

  .section-head{
    max-width:640px;
    margin-bottom:52px;
  }
  .section-head .eyebrow{color:var(--orange);}
  .band-green .section-head .eyebrow{color:var(--orange-soft);}
  .section-head h2{font-size:clamp(1.8rem, 3vw, 2.4rem);}
  .section-head p{margin-top:16px; color:var(--ink-soft); font-size:1.05rem;}
  .band-green .section-head p{color:#E3C7EE;}

  /* About */
  .about-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:64px;
  }
  .about-grid p + p{margin-top:18px;}
  .about-grid .stat-row{
    display:flex;
    gap:40px;
    margin-top:36px;
    padding-top:28px;
    border-top:1px solid rgba(255,255,255,0.18);
  }
  .stat-row div strong{
    display:block;
    font-family:'Fraunces', serif;
    font-size:2rem;
    color:var(--orange-soft);
  }
  .stat-row div span{font-size:0.85rem; color:#E3C7EE;}
  @media (max-width:820px){ .about-grid{grid-template-columns:1fr;} }

  /* Founder's story */
  .founder-grid{
    display:grid;
    grid-template-columns:0.85fr 1.15fr;
    gap:56px;
    align-items:start;
  }
  .founder-photo{
    border-radius:14px;
    overflow:hidden;
    border:1px solid rgba(255,255,255,0.15);
  }
  .founder-photo img{width:100%; display:block;}
  .founder-name{font-size:1.4rem; margin-bottom:2px;}
  .founder-title{font-size:0.9rem; color:var(--gold-soft, #E8D3AA); opacity:0.9; display:block; margin-bottom:22px;}
  .band-green .founder-title{color:#E3C7EE;}
  .founder-copy p{margin-bottom:14px;}
  .founder-quote{
    margin-top:24px;
    padding:22px 26px;
    border-left:3px solid var(--pink);
    background:rgba(255,255,255,0.06);
    font-family:'Fraunces', serif;
    font-size:1.3rem;
    font-style:italic;
  }
  @media (max-width:820px){ .founder-grid{grid-template-columns:1fr;} .founder-photo{max-width:280px;} }

  /* Team */
  .team-grid{
    display:flex;
    flex-wrap:wrap;
    gap:22px;
  }
  .team-card{
    flex:1 1 200px;
    max-width:240px;
    background:#fff;
    border:1px solid var(--line);
    border-radius:14px;
    padding:26px 24px;
    transition:transform .18s ease, box-shadow .18s ease;
  }
  .team-card:hover{
    transform:translateY(-3px);
    box-shadow:0 16px 32px -18px rgba(74,20,90,0.35);
  }
  .team-avatar{
    width:50px; height:50px;
    border-radius:50%;
    display:flex; align-items:center; justify-content:center;
    font-family:'Fraunces', serif;
    font-weight:600;
    font-size:1.05rem;
    color:#fff;
    margin-bottom:18px;
  }
  .team-card:nth-of-type(4n+1) .team-avatar{background:var(--pink);}
  .team-card:nth-of-type(4n+2) .team-avatar{background:var(--purple);}
  .team-card:nth-of-type(4n+3) .team-avatar{background:var(--orange);}
  .team-card:nth-of-type(4n+4) .team-avatar{background:var(--green);}
  .team-card h3{font-size:1.05rem; margin-bottom:6px;}
  .team-card span{font-size:0.85rem; color:var(--ink-soft); font-weight:500;}

  /* Trust / certificate */
  .trust-grid{
    display:grid;
    grid-template-columns:0.8fr 1.2fr;
    gap:56px;
    align-items:center;
  }
  .cert-frame{
    border:1px solid var(--line);
    border-radius:6px;
    overflow:hidden;
    box-shadow:0 18px 40px -20px rgba(74,20,90,0.35);
  }
  .cert-frame img{width:100%; display:block;}
  .trust-badges{
    display:flex; flex-wrap:wrap; gap:12px;
    margin-top:24px;
  }
  .trust-badge{
    display:inline-flex; align-items:center; gap:8px;
    padding:9px 16px;
    border:1px solid var(--line);
    border-radius:999px;
    font-size:0.85rem;
    color:var(--ink-soft);
    background:#fff;
  }
  .trust-badge svg{width:16px; height:16px; color:var(--purple); flex-shrink:0;}
  @media (max-width:820px){ .trust-grid{grid-template-columns:1fr;} }

  /* Programs */
  .program-row{
    display:grid;
    grid-template-columns:56px 1fr;
    gap:26px;
    padding:34px 0;
    border-top:1px solid var(--line);
  }
  .program-row:last-child{border-bottom:1px solid var(--line);}
  .program-icon{
    width:52px; height:52px;
    border-radius:50%;
    background:var(--lavender);
    display:flex; align-items:center; justify-content:center;
  }
  .program-icon svg{width:24px; height:24px; color:var(--purple-deep);}
  .program-row:nth-of-type(5n+1) .program-icon{background:#FBE1EE;}
  .program-row:nth-of-type(5n+1) .program-icon svg{color:var(--pink-deep);}
  .program-row:nth-of-type(5n+2) .program-icon{background:#E4F5E2;}
  .program-row:nth-of-type(5n+2) .program-icon svg{color:#1E8A1B;}
  .program-row:nth-of-type(5n+3) .program-icon{background:#FBE9D2;}
  .program-row:nth-of-type(5n+3) .program-icon svg{color:#A65E00;}
  .program-row:nth-of-type(5n+4) .program-icon{background:var(--lavender);}
  .program-row:nth-of-type(5n+4) .program-icon svg{color:var(--purple-deep);}
  .program-row:nth-of-type(5n+5) .program-icon{background:#FBE1EE;}
  .program-row:nth-of-type(5n+5) .program-icon svg{color:var(--pink-deep);}
  .program-row h3{font-size:1.3rem; margin-bottom:8px;}
  .program-row p{color:var(--ink-soft); max-width:60ch;}

  /* Where we serve */
  .homes-grid{
    display:flex;
    flex-wrap:wrap;
    gap:12px;
    margin-top:8px;
  }
  .home-chip{
    display:inline-block;
    background:#fff;
    border:1px solid var(--line);
    color:var(--purple-deep);
    font-weight:500;
    font-size:0.92rem;
    padding:10px 18px;
    border-radius:999px;
  }
  .street-feeding-note{
    margin-top:26px;
    color:var(--ink-soft);
    font-size:0.98rem;
  }
  .street-feeding-note strong{color:var(--pink-deep);}

  /* Gallery */
  .gallery-grid{
    display:grid;
    grid-template-columns:repeat(4, 1fr);
    grid-auto-rows:140px;
    grid-auto-flow:dense;
    gap:12px;
  }
  .gallery-item{
    position:relative;
    border-radius:10px;
    overflow:hidden;
    background:var(--lavender);
    box-shadow:0 10px 24px -16px rgba(74,20,90,0.4);
  }
  .gallery-item a{display:block; width:100%; height:100%;}
  .gallery-item img{
    width:100%; height:100%;
    object-fit:cover;
    display:block;
    transition:transform .35s ease;
  }
  .gallery-item:hover img{transform:scale(1.06);}
  .gallery-item .cap{
    position:absolute; left:0; right:0; bottom:0;
    padding:22px 14px 10px;
    background:linear-gradient(to top, rgba(20,10,25,0.82), rgba(20,10,25,0));
    color:#fff;
    font-size:0.8rem;
    font-weight:500;
    line-height:1.3;
  }
  .gallery-item .zoom-hint{
    position:absolute; top:10px; right:10px;
    width:28px; height:28px;
    border-radius:50%;
    background:rgba(20,10,25,0.45);
    display:flex; align-items:center; justify-content:center;
    opacity:0;
    transition:opacity .2s ease;
  }
  .gallery-item:hover .zoom-hint{opacity:1;}
  .gallery-item .zoom-hint svg{width:14px; height:14px; color:#fff;}
  .gallery-item.tall{grid-row:span 2;}
  .gallery-item.wide{grid-column:span 2;}
  @media (max-width:820px){
    .gallery-grid{grid-template-columns:repeat(2, 1fr); grid-auto-rows:150px;}
  }
  @media (max-width:480px){
    .gallery-grid{grid-template-columns:1fr 1fr; grid-auto-rows:130px; gap:8px;}
    .gallery-item .cap{font-size:0.72rem; padding:16px 10px 8px;}
  }

  /* Gallery lightbox (no-JS, :target based) */
  .lightbox{
    display:none;
    position:fixed; inset:0; z-index:100;
    background:rgba(15,8,20,0.92);
    padding:40px 20px;
    align-items:center; justify-content:center;
  }
  .lightbox:target{display:flex;}
  .lightbox-inner{
    max-width:900px; width:100%;
    display:flex; flex-direction:column; align-items:center;
    gap:16px;
  }
  .lightbox-inner img{
    max-width:100%; max-height:74vh;
    border-radius:8px;
    display:block;
    box-shadow:0 30px 60px -20px rgba(0,0,0,0.6);
  }
  .lightbox-cap{color:#F3EEF6; font-size:0.95rem; text-align:center; max-width:60ch;}
  .lightbox-close{
    position:absolute; top:24px; right:28px;
    width:42px; height:42px;
    border-radius:50%;
    background:rgba(255,255,255,0.12);
    color:#fff;
    display:flex; align-items:center; justify-content:center;
    text-decoration:none;
    font-size:1.4rem;
    line-height:1;
  }
  .lightbox-close:hover{background:rgba(255,255,255,0.22);}

  /* Impact */
  .impact-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:40px;
  }
  .impact-grid .num{
    font-family:'Fraunces', serif;
    font-size:clamp(2.2rem,4vw,3rem);
    color:var(--purple-deep);
  }
  .impact-grid .label{color:var(--ink-soft); margin-top:6px; font-size:0.95rem;}
  @media (max-width:700px){ .impact-grid{grid-template-columns:1fr 1fr; row-gap:32px;} }

  /* Get involved */
  .involve-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:2px;
    background:var(--line);
    border:1px solid var(--line);
  }
  .involve-card{
    background:var(--bg);
    padding:44px;
  }
  .involve-card h3{font-size:1.5rem; margin-bottom:14px;}
  .involve-card p{color:var(--ink-soft); margin-bottom:26px;}
  .pay-details{
    border:1px solid var(--line);
    border-radius:10px;
    overflow:hidden;
  }
  .pay-row{
    display:flex; justify-content:space-between; align-items:center;
    padding:12px 16px;
    font-size:0.92rem;
  }
  .pay-row:nth-child(odd){background:var(--lavender);}
  .pay-label{color:var(--ink-soft);}
  .pay-value{font-weight:600; color:var(--ink); font-family:'Fraunces', serif;}
  @media (max-width:820px){ .involve-grid{grid-template-columns:1fr;} }

  /* Intake form */
  .intake{
    margin-top:48px;
    background:#fff;
    border:1px solid var(--line);
    border-radius:14px;
    padding:36px;
    max-width:640px;
  }
  .intake h3{font-size:1.2rem; margin-bottom:6px;}
  .intake > p{color:var(--ink-soft); font-size:0.92rem; margin-bottom:22px;}
  .intake-row{display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:16px;}
  .intake label{display:block; font-size:0.82rem; color:var(--ink-soft); margin-bottom:6px; font-weight:500;}
  .intake input, .intake select, .intake textarea{
    width:100%;
    padding:11px 13px;
    border:1px solid var(--line);
    border-radius:6px;
    font-family:'Work Sans', sans-serif;
    font-size:0.95rem;
    color:var(--ink);
    background:var(--bg);
  }
  .intake input:focus, .intake select:focus, .intake textarea:focus{
    outline:2px solid var(--pink); outline-offset:1px; border-color:transparent;
  }
  .intake textarea{resize:vertical; min-height:90px; margin-bottom:20px;}
  .intake-field{margin-bottom:16px;}
  .intake .btn{border:none; cursor:pointer;}
  @media (max-width:600px){ .intake-row{grid-template-columns:1fr;} .intake{padding:26px;} }

  /* Financial transparency */
  .transparency-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:56px;
    align-items:start;
  }
  .transparency-note{
    background:#fff;
    border:1px solid var(--line);
    border-radius:14px;
    padding:32px;
  }
  .transparency-note h3{font-size:1.15rem; margin-bottom:12px;}
  .transparency-note p{color:var(--ink-soft); font-size:0.95rem;}
  .transparency-note p + p{margin-top:14px;}
  .tax-note{
    font-size:0.85rem !important;
    color:var(--purple-deep) !important;
    background:var(--lavender);
    padding:14px 16px;
    border-radius:8px;
  }
  @media (max-width:820px){ .transparency-grid{grid-template-columns:1fr;} }

  /* News / updates */
  .news-placeholder{
    background:#fff;
    border:1px dashed var(--line);
    border-radius:14px;
    padding:40px;
    text-align:center;
    color:var(--ink-soft);
  }
  .news-placeholder a{color:var(--pink); font-weight:500; text-decoration:none;}
  .news-placeholder a:hover{text-decoration:underline;}

  /* Legal (privacy / terms) */
  .legal{padding:64px 0 0;}
  .legal details{
    border-top:1px solid var(--line);
    padding:22px 0;
  }
  .legal details:last-of-type{border-bottom:1px solid var(--line);}
  .legal summary{
    cursor:pointer;
    font-family:'Fraunces', serif;
    font-size:1.05rem;
    font-weight:600;
    list-style:none;
    display:flex; justify-content:space-between; align-items:center;
  }
  .legal summary::-webkit-details-marker{display:none;}
  .legal summary::after{content:"+"; font-size:1.3rem; color:var(--pink); font-family:'Work Sans', sans-serif;}
  .legal details[open] summary::after{content:"–";}
  .legal .legal-body{margin-top:16px; color:var(--ink-soft); font-size:0.92rem; max-width:70ch;}
  .legal .legal-body p + p{margin-top:12px;}
  .legal .legal-draft-note{
    display:inline-block;
    margin-top:18px;
    font-size:0.78rem;
    color:var(--pink-deep);
    background:#FBE1EE;
    padding:5px 12px;
    border-radius:999px;
    font-weight:500;
  }

  /* Contact / footer */
  footer{
    background:var(--ink);
    color:#DCE4DE;
    padding:64px 0 32px;
  }
  .footer-grid{
    display:grid;
    grid-template-columns:1.3fr 1fr 1fr;
    gap:48px;
