<script>
  const menubtn = document.getElementById('menubtn');
  const navlinks = document.getElementById('navlinks');
  menubtn.addEventListener('click', () => {
    const isOpen = navlinks.classList.toggle('open');
    menubtn.setAttribute('aria-expanded', isOpen);
  });
  navlinks.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
    navlinks.classList.remove('open');
    menubtn.setAttribute('aria-expanded', 'false');
  }));

  const intakeForm = document.getElementById('intakeForm');
  if(intakeForm){
    intakeForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = document.getElementById('intakeName').value.trim();
      const email = document.getElementById('intakeEmail').value.trim();
      const reason = document.getElementById('intakeReason').value;
      const message = document.getElementById('intakeMessage').value.trim();
      const subject = encodeURIComponent(`Elysian Hope Foundation — ${reason} inquiry`);
      const body = encodeURIComponent(
        `Name: ${name}\nEmail: ${email}\nInterested in: ${reason}\n\nMessage:\n${message}`
      );
      window.location.href = `mailto:elysianhopefoundation254@gmail.com?subject=${subject}&body=${body}`;
    });
  }
